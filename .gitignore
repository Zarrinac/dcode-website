# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pm2 ecosystem.config.cjs
/ecosystem.config.cjs

# D'code media is staged in the sibling ../media folder and promoted to the
# server; the heavy renders are served from NEXT_PUBLIC_MEDIA_BASE_URL in prod.
# public/dcode stays committed so local dev (NEXT_PUBLIC_CONTENT_SOURCE=local)
# works out of the box.

/app/generated/prisma

# temp files
/temp-files

# database backups — never commit dumps (may contain PII)
/backups/

# Stale sitemaps/robots — the sitemap and robots are served by app/sitemap.ts
# and app/robots.ts. Keep these ignored so a leftover build artifact is never
# committed.
/public/sitemap*.xml
/public/robots.txt
