# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pm2 ecosystem.config.cjs
/ecosystem.config.cjs

# D'code media is staged in the sibling ../media folder (built by
# `npm run media:optimize`) and promoted to the server; in prod the heavy assets are
# served from NEXT_PUBLIC_MEDIA_BASE_URL. The renders/video/datasheets are NOT
# committed — they live locally under public/ for dev and in ../media for the server.
# Keep the tiny SVG logo and the root favicons/manifest so the app still builds & runs
# without the media folder present.
/public/dcode/**/*.png
/public/dcode/**/*.jpg
/public/dcode/**/*.jpeg
/public/dcode/**/*.webp
/public/dcode/**/*.avif
/public/dcode/**/*.mp4
/public/dcode/**/*.pdf
/public/logos/*.png
/public/logos/*.jpg
/public/logos/*.webp

/app/generated/prisma

# temp files
/temp-files

# database backups — never commit dumps (may contain PII)
/backups/

# Stale sitemaps/robots — the sitemap and robots are served by app/sitemap.ts
# and app/robots.ts. Keep these ignored so a leftover build artifact is never
# committed.
/public/sitemap*.xml
/public/robots.txt

# graphify knowledge-graph output (generated, not committed)
/graphify-out/
