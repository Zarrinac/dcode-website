// D'code product catalog schema. D'code ships two families today — LED TVs (R6D)
// and split air conditioners (DTEC30). The model is family-agnostic: shared columns
// plus a localized `attributes` spec sheet (Json) that works for any category. Each
// product has size/capacity `variants` (a SKU each) and localized `copies`.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DcodeCategory {
  TV
  AC
}

model DcodeProduct {
  id             String        @id
  slug           String        @unique
  brand          String        @default("dcode")
  category       DcodeCategory @default(TV)
  series         String
  warrantyMonths Int?
  extras         String[]      @default([])
  heroImageUrl   String
  heroVideoUrl   String?
  remoteImageUrl String?
  gallery        Json?
  featureCards   Json?
  attributes     Json?
  remotes        Json?
  specs          Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  variants DcodeVariant[]
  copies   DcodeProductCopy[]

  @@index([category])
}

model DcodeVariant {
  sku                    String  @id
  productId              String
  size                   String
  diagonalInch           Int?
  capacityBtu            Int?
  imageUrl               String
  dimensionsWithoutStand String?
  dimensionsWithStand    String?
  netWeight              String?
  sortOrder              Int     @default(0)

  product DcodeProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model DcodeProductCopy {
  id          String   @id @default(cuid())
  productId   String
  locale      String
  name        String
  tagline     String
  description String?
  highlights  String[] @default([])

  product DcodeProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}
